# Default: Gemini API free tier. Get a key at aistudio.google.com.
# Use the exact model ID shown in AI Studio for a Flash or Flash-Lite model on the free tier.
LLM_MODEL=gemini/<flash-model-id>
EMBED_MODEL=gemini/<embedding-model-id>
GEMINI_API_KEY=
LLM_RPM=10                 # set to your project's free-tier RPM from AI Studio
LLM_THINKING_LEVEL=low     # Gemini 3.x only: minimal | low | medium | high
REWRITE_MODE=batch         # batch | per_bullet (per_bullet for small local models)

# Automatic fallback if the above fails after retries (e.g. the Gemini
# free-tier daily quota is exhausted) — no .env editing needed mid-run.
# Requires `ollama serve` running locally, and `ollama pull` for both models.
LLM_FALLBACK_MODEL=ollama/qwen3:8b
EMBED_FALLBACK_MODEL=ollama/nomic-embed-text
OLLAMA_API_BASE=http://localhost:11434

# Local-only alternative (skip Gemini/ANTHROPIC vars above entirely):
# LLM_MODEL=ollama/qwen3:8b
# EMBED_MODEL=ollama/nomic-embed-text
# OLLAMA_API_BASE=http://localhost:11434
# REWRITE_MODE=per_bullet

# Paid alternative:
# LLM_MODEL=anthropic/claude-haiku-4-5
# ANTHROPIC_API_KEY=
